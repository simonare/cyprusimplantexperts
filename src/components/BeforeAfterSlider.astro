---
interface Props {
  beforeImage: string;
  afterImage: string;
  title?: string;
  caption?: string;
  autoPlay?: boolean;
}

const { beforeImage, afterImage, title, caption, autoPlay = true } = Astro.props;

const componentId = `ba-${Math.random().toString(36).substring(2, 9)}`;
---

<div class={`before-after-slider ${componentId}`}>
  <div class="ba-container">
    <!-- After Image (Background) -->
    <img src={afterImage} alt="After" class="ba-image ba-after" loading="lazy" />

    <!-- Before Image (Overlay) -->
    <div class="ba-overlay">
      <img src={beforeImage} alt="Before" class="ba-image ba-before" loading="lazy" />
    </div>

    <!-- Slider Divider -->
    <div class="ba-divider">
      <div class="ba-handle">
        <svg class="ba-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M15 18l-6-6 6-6"></path>
          <path d="M9 18l6-6-6-6"></path>
        </svg>
      </div>
    </div>

    <!-- Labels -->
    <div class="ba-label ba-before-label">
      <span class="ba-text">Before</span>
    </div>
    <div class="ba-label ba-after-label">
      <span class="ba-text">After</span>
    </div>
  </div>

  {title && <div class="ba-title">{title}</div>}
  {caption && <div class="ba-caption">{caption}</div>}
</div>

<style define:vars={{ componentId }}>
  .before-after-slider {
    max-width: 100%;
    width: 100%;
  }

  .ba-container {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: #f3f4f6;
    border-radius: 1rem;
    aspect-ratio: 4 / 3;
    --position: 50%;
    touch-action: none;
  }

  .ba-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    user-select: none;
    -webkit-user-drag: none;
  }

  .ba-after {
    z-index: 1;
  }

  .ba-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    cursor: ew-resize;
    clip-path: inset(0 calc(100% - var(--position)) 0 0);
  }

  .ba-before {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .ba-divider {
    position: absolute;
    top: 0;
    left: var(--position);
    width: 4px;
    height: 100%;
    background-color: white;
    transform: translateX(-50%);
    z-index: 3;
    cursor: ew-resize;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.2);
  }

  .ba-handle {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 56px;
    height: 56px;
    background-color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
    color: #1e3a8a;
    transition: transform 0.3s ease;
  }

  .ba-container:hover .ba-handle {
    transform: translate(-50%, -50%) scale(1.1);
  }

  .ba-icon {
    width: 24px;
    height: 24px;
  }

  .ba-label {
    position: absolute;
    top: 12px;
    padding: 6px 12px;
    background-color: rgba(255, 255, 255, 0.95);
    border-radius: 9999px;
    z-index: 4;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #334155;
    backdrop-filter: blur(4px);
  }

  .ba-before-label {
    left: 12px;
  }

  .ba-after-label {
    right: 12px;
  }

  .ba-title {
    margin-top: 16px;
    font-size: 18px;
    font-weight: 600;
    color: #1e293b;
  }

  .ba-caption {
    margin-top: 8px;
    font-size: 14px;
    color: #64748b;
  }

  @media (max-width: 768px) {
    .ba-handle {
      width: 48px;
      height: 48px;
    }

    .ba-icon {
      width: 20px;
      height: 20px;
    }
  }
</style>

<script define:vars={{ componentId, autoPlay }}>
  class BeforeAfterSlider {
    constructor(container) {
      this.container = container;
      this.viewport = container.querySelector(".ba-container");
      this.overlay = container.querySelector(".ba-overlay");
      this.divider = container.querySelector(".ba-divider");
      this.handle = container.querySelector(".ba-handle");
      this.isDragging = false;
      this.autoPlayActive = true;
      this.autoPlayInterval = null;

      this.init();
    }

    init() {
      this.viewport.addEventListener("mousedown", (e) => this.startDrag(e));
      this.viewport.addEventListener("touchstart", (e) => this.startDrag(e));
      document.addEventListener("mousemove", (e) => this.drag(e));
      document.addEventListener("touchmove", (e) => this.drag(e));
      document.addEventListener("mouseup", () => this.endDrag());
      document.addEventListener("touchend", () => this.endDrag());

      // Click anywhere on the container to move the slider
      this.viewport.addEventListener("click", (e) => {
        if (!this.isDragging) {
          this.moveSliderToClick(e);
        }
      });

      // Start auto-play animation if enabled
      if (autoPlay) {
        this.startAutoPlay();
      }
    }

    startDrag(e) {
      e.preventDefault();
      this.isDragging = true;
      this.autoPlayActive = false;
      this.clearAutoPlay();
    }

    drag(e) {
      if (!this.isDragging) return;
      e.preventDefault();

      const rect = this.viewport.getBoundingClientRect();
      const x = (e.clientX || e.touches?.[0]?.clientX) - rect.left;
      const position = Math.max(0, Math.min(x, rect.width));
      const percentage = (position / rect.width) * 100;

      this.updateSlider(percentage);
    }

    endDrag() {
      if (this.isDragging) {
        this.isDragging = false;
        // Resume auto-play after a short delay
        setTimeout(() => {
          if (autoPlay) {
            this.autoPlayActive = true;
            this.startAutoPlay();
          }
        }, 1000);
      }
    }

    moveSliderToClick(e) {
      const rect = this.viewport.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const percentage = (x / rect.width) * 100;
      this.updateSlider(percentage);
    }

    updateSlider(percentage) {
      const clamped = Math.max(0, Math.min(percentage, 100));
      this.viewport.style.setProperty("--position", clamped + "%");
    }

    startAutoPlay() {
      if (this.autoPlayInterval) return;

      let direction = 1;
      let position = 50;

      const animate = () => {
        if (!this.autoPlayActive) return;

        // Random movement
        position += direction * (Math.random() * 3 + 1);

        // Reverse direction at boundaries
        if (position >= 100) {
          position = 100;
          direction = -1;
        } else if (position <= 0) {
          position = 0;
          direction = 1;
        }

        this.updateSlider(position);
      };

      this.autoPlayInterval = setInterval(animate, 100);
    }

    clearAutoPlay() {
      if (this.autoPlayInterval) {
        clearInterval(this.autoPlayInterval);
        this.autoPlayInterval = null;
      }
    }
  }

  // Initialize the slider when the script loads
  const sliders = document.querySelectorAll(`.${componentId}`);
  sliders.forEach((slider) => {
    new BeforeAfterSlider(slider);
  });
</script>
